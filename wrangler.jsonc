{
  // Worker name (must be unique on Cloudflare)
  "name": "multi-time-link-opener",
  
  // Entry point file
  "main": "src/index.js",
  
  // Compatibility date for the Workers runtime
  "compatibility_date": "2024-12-18",
  
  // Environment variables for all environments
  "vars": {
    "MAX_TEST_COUNT": 500,          // Maximum test count per request
    "REQUEST_TIMEOUT_MS": 15000,    // Default timeout in milliseconds
    "RATE_LIMIT_PER_MINUTE": 35,    // Rate limit per IP per minute
    "ALLOWED_HOSTS": "example.com,api.example.com,test.com", // Comma-separated
    "PROXY_LIST": "",               // Comma-separated proxy list
    "PROXY_SERVICE_ENDPOINT": "",   // External proxy service URL
    "PROXY_API_KEY": ""             // API key for proxy service
  },
  
  // Environment-specific overrides
  "env": {
    "production": {
      "vars": {
        "MAX_TEST_COUNT": 500,
        "REQUEST_TIMEOUT_MS": 15000,
        "RATE_LIMIT_PER_MINUTE": 35,
        "ALLOWED_HOSTS": "example.com,api.example.com"
      }
    },
    "dev": {
      "vars": {
        "MAX_TEST_COUNT": 50,
        "REQUEST_TIMEOUT_MS": 10000,
        "RATE_LIMIT_PER_MINUTE": 10,
        "ALLOWED_HOSTS": "localhost,test.com"
      }
    }
  }
}
